# ===== 楽曲抽出システム 環境変数（Vercel → Project → Settings → Environment Variables に設定）=====
# すべて任意。設定すると利用者はキー入力なしで各モードを使えます。

# AI抽出（どちらか一方でOK。おすすめは Gemini）
GEMINI_API_KEY=
OPENAI_API_KEY=
# モデルを固定したい場合のみ（未設定なら自動で利用可能なモデルを選択）
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-5-mini

# YouTube Data API v3（プレイリスト展開・再生数/コメント数）
YOUTUBE_API_KEY=

# サーバーのキーを他人に使われないための合言葉（設定すると利用時に入力が必要）
APP_PASSCODE=

# お問い合わせの送信先
CONTACT_EMAIL=
