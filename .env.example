# ===== 楽曲抽出システム 環境変数（Vercel → Project → Settings → Environment Variables に設定）=====
# すべて任意。値は秘密情報なので、Git にコミットしないこと（.env.local は .gitignore 済み）。

# ----- Google ログイン（3つそろうと有効化。手順は README の「ログインの設定」）-----
# AUTH_SECRET は `npx auth secret` または `openssl rand -base64 32` で作った長い乱数
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# サーバーの API キー（下の GEMINI/OPENAI/YOUTUBE）を使ってよいアカウント（カンマ区切り）
# 未設定なら誰もサーバーのキーを使えない（各自が設定画面で自分のキーを入力）
SERVER_KEY_EMAILS=
# true にすると未ログインでも抽出できる（既定はログイン必須）
# AUTH_ALLOW_GUEST=true

# ----- AI抽出（どちらか一方でOK。おすすめは Gemini）-----
GEMINI_API_KEY=
OPENAI_API_KEY=
# モデルを固定したい場合のみ（未設定なら自動で利用可能なモデルを選択）
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-5-mini

# ----- YouTube Data API v3（プレイリスト展開・再生数/コメント数）-----
YOUTUBE_API_KEY=

# ログインを使わない場合の簡易保護：合言葉（設定すると利用時に入力が必要）
APP_PASSCODE=

# お問い合わせの送信先
CONTACT_EMAIL=
